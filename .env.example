# ===== healthy-life 环境变量（复制为 .env 使用，勿提交 .env）=====

# 服务端口
PORT=8787
# 对外可访问的地址（用于生成邀请链接，部署时改成 VPS 的 https 地址）
BASE_URL=http://localhost:8787

# SQLite 数据库文件路径
DB_PATH=./data/healthy-life.db

# ntfy 推送服务
NTFY_BASE_URL=https://ntfy.sh
# 发布用 token（服务端推送需要），可为空
NTFY_TOKEN=
NTFY_TOPIC_REMINDER=healthy-life-reminder
NTFY_TOPIC_REPORT=healthy-life-report

# 时区与「打卡日」切分边界（小时，0-23）
TIMEZONE=Asia/Shanghai
DAY_BOUNDARY_HOUR=5

# 定时任务时间（HH:mm，按群时区）
REMINDER_TIME=22:30
REPORT_TIME=08:00

# 系统管理员默认口令（仅首次创建 admin 时用，之后可在后台修改）
ADMIN_PASSWORD=admin123
